# ════════════════════════════════════════════════════════════════
# VARSHANETRA — Environment Variables
# Copy this file to .env.local and fill in your values
# ════════════════════════════════════════════════════════════════

# ── DATABASE (Required) ──────────────────────────────────────────
# MongoDB connection string (Atlas SRV or direct)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/varshanetra?retryWrites=true&w=majority

# ── AI CHAT (Required for VARSHA AI chatbot) ─────────────────────
# Get a free Gemini API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── ML INFERENCE SERVER (Optional) ──────────────────────────────
# The default npm run dev service is Flask on port 5000.
# For the optional trained PyTorch service, run Models_Only/ml_server.py
# and change this value to http://localhost:8000.
ML_SERVER_URL=http://localhost:5000

# ── APPLICATION ───────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ── DEMO MODE (Shows OTP in toast notification for testing) ───────
# Set to "true" for hackathon demos so judges can verify without SMS
DEMO_MODE=true

# ── SMS ALERTS (Optional — for real SMS delivery) ────────────────
# Twilio credentials for actual SMS/WhatsApp alerts
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ── EMAIL ALERTS (Optional) ──────────────────────────────────────
# Resend (free tier: 3000 emails/month) — https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=alerts@varshanetra.imd.gov.in

# ── PUSH NOTIFICATIONS (Optional) ────────────────────────────────
FIREBASE_SERVER_KEY=
NEXT_PUBLIC_FIREBASE_CONFIG=

# ── STORAGE (Optional — for bulletin PDF storage) ────────────────
STORAGE_BUCKET=
STORAGE_REGION=ap-south-1
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# ════════════════════════════════════════════════════════════════
# QUICK SETUP (5 minutes):
#
# 1. Copy this file:
#    cp .env.example .env.local  (Linux/Mac)
#    copy .env.example .env.local  (Windows)
#
# 2. Set MONGODB_URI (free Atlas cluster at mongodb.com/cloud/atlas)
#
# 3. Set GEMINI_API_KEY (free at aistudio.google.com)
#
# 4. Start development server:
#    npm run dev
#
# 5. Database auto-seeds on first visit to http://localhost:3000
#
# 6. Admin login: +919999999999 / Admin@1234
#
# OPTIONAL — Start trained PyTorch inference server:
#    cd Models_Only
#    pip install -r requirements.txt
#    python ml_server.py
# ════════════════════════════════════════════════════════════════
